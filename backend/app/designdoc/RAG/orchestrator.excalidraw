      "updated": 1791837087905,
      "link": null,
      "locked": false,
      "text": "MemoryContext: session, procedures, evidence_chunks\n - prompt_text: build prompt dynamically\n     - summary\n     - entities \n     - recent conversation\n     - user_items: user preference\n     - org_items: memeory about orgs\nMemoryContextBuilder: store, work, epis, user_semantic, ...(all memory)\n    - build\n        - recall all memory related \n        - apply budget\n            - pop org/user/recent message to meet max_chars\n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 318,
      "containerId": null,
      "originalText": "MemoryContext: session, procedures, evidence_chunks\n - prompt_text: build prompt dynamically\n     - summary\n     - entities \n     - recent conversation\n     - user_items: user preference\n     - org_items: memeory about orgs\nMemoryContextBuilder: store, work, epis, user_semantic, ...(all memory)\n    - build\n        - recall all memory related \n        - apply budget\n            - pop org/user/recent message to meet max_chars\n",
      "lineHeight": 1.25
    },
