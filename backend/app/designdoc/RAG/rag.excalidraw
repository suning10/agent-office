    {
      "id": "_cpdgSuYQgYLEzd4ENGa4",
      "type": "text",
      "x": 280,
      "y": 438,
      "width": 457.7396545410156,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1819056974,
      "version": 716,
      "versionNonce": 1868952142,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791920949041,
      "link": null,
      "locked": false,
      "text": "1. api/route/documents.py\n    - params:\n        - request/file\n        - depts\n        - depend(require_admin)\n    - upload to shared folder\n    - job_queue.enqueue \n        - job type\n        - payload\n        - status\n        - ts\n\n2. storage/job_queue.py\n    - init\n        - store/session_store\n        - stream_name\n        - consumer_name (worker)\n    - enqueue\n        - add to store\n        - add to redis (xadd only job id)\n            - stream_name\n            - job_id, job type\n    - next job\n        - consume the next job_id from redis \n        - upsert into store \n        - xgroup_create\n        - xreadgroup \n    - finish \n        - update store status\n        - send ack to redis\n3. scripts/async_worker.py\n    - process based on job type\n    \n    \n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 868,
      "containerId": null,
      "originalText": "1. api/route/documents.py\n    - params:\n        - request/file\n        - depts\n        - depend(require_admin)\n    - upload to shared folder\n    - job_queue.enqueue \n        - job type\n        - payload\n        - status\n        - ts\n\n2. storage/job_queue.py\n    - init\n        - store/session_store\n        - stream_name\n        - consumer_name (worker)\n    - enqueue\n        - add to store\n        - add to redis (xadd only job id)\n            - stream_name\n            - job_id, job type\n    - next job\n        - consume the next job_id from redis \n        - upsert into store \n        - xgroup_create\n        - xreadgroup \n    - finish \n        - update store status\n        - send ack to redis\n3. scripts/async_worker.py\n    - process based on job type\n    \n    \n",
      "lineHeight": 1.25
    },
