    {
      "id": "EYbGTAvpbBaUArr4BCwS0",
      "type": "text",
      "x": 1285,
      "y": 1221,
      "width": 398.4396667480469,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 16499369,
      "version": 396,
      "versionNonce": 2093424265,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792011199016,
      "link": null,
      "locked": false,
      "text": "+ detect_reference(doc) - rule level\n    - return the reference of doc\n    - by looking at title\n\n+ detect_conflicts(doc) - semantic level\n    - use LLM to verdict \n        - by confidence threshold\n    -  get other doc (!= depts & id)\n    - search_similar (chunk, top)\n        - embed the chunk \n        - search from vdb \n    - check the overlap by keyword\n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 318,
      "containerId": null,
      "originalText": "+ detect_reference(doc) - rule level\n    - return the reference of doc\n    - by looking at title\n\n+ detect_conflicts(doc) - semantic level\n    - use LLM to verdict \n        - by confidence threshold\n    -  get other doc (!= depts & id)\n    - search_similar (chunk, top)\n        - embed the chunk \n        - search from vdb \n    - check the overlap by keyword\n",
      "lineHeight": 1.25
    },
    {
      "id": "y4LwmJPFupFnw3WVwK-C3",
      "type": "text",
      "x": 1682,
      "y": 1145,
      "width": 516.1796875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
