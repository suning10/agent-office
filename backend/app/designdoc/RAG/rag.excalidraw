      "isDeleted": false,
      "boundElements": null,
      "updated": 1792010469242,
      "link": null,
      "locked": false,
      "text": "            Relation:\n            \"_id\": uuid.uuid4().hex,\n            \"from_doc\": from_doc[\"_id\"],\n            \"from_dept\": from_doc.get(\"dept_id\", \"\"),\n            \"to_doc\": to_doc.get(\"_id\", \"\"),\n            \"to_dept\": to_doc.get(\"dept_id\", \"\"),\n            \"relation_type\": rel_type,\n            \"description\": desc,\n            \"auto_detected\": True,\n            \"confidence\": round(float(confidence), 3),\n            \"verified_by\": None,\n            \"created_at\": _now_iso(),",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 293,
      "containerId": null,
      "originalText": "            Relation:\n            \"_id\": uuid.uuid4().hex,\n            \"from_doc\": from_doc[\"_id\"],\n            \"from_dept\": from_doc.get(\"dept_id\", \"\"),\n            \"to_doc\": to_doc.get(\"_id\", \"\"),\n            \"to_dept\": to_doc.get(\"dept_id\", \"\"),\n            \"relation_type\": rel_type,\n            \"description\": desc,\n            \"auto_detected\": True,\n            \"confidence\": round(float(confidence), 3),\n            \"verified_by\": None,\n            \"created_at\": _now_iso(),",
      "lineHeight": 1.25
    },
