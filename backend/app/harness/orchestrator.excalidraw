    {
      "id": "kBdLjRoPEKDGGwcgdOZL-",
      "type": "text",
      "x": 1367,
      "y": 2916,
      "width": 606.2395629882812,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 372293519,
      "version": 656,
      "versionNonce": 1286598881,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791578493505,
      "link": null,
      "locked": false,
      "text": "1. find matched skill\n    - skill_executor \\loop\n        - cls SkillPlan\n            - query, top_k, \n            - instruction \n            - skills\n        - SkillExecutor\n            - DataStore\n            - top_k\n            + match \n              - get active skills\n              - check \n                - scope == global\n                - allow, dept allow\n                - match any intent_pattern (query)\n2. prepare a skill plan \n    - use a bucket (hash) to determine treatment or control\n        - only execute treatment \n3. execute_workflow\n    - generete workflow \n        - based on action.steps\n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 543,
      "containerId": null,
      "originalText": "1. find matched skill\n    - skill_executor \\loop\n        - cls SkillPlan\n            - query, top_k, \n            - instruction \n            - skills\n        - SkillExecutor\n            - DataStore\n            - top_k\n            + match \n              - get active skills\n              - check \n                - scope == global\n                - allow, dept allow\n                - match any intent_pattern (query)\n2. prepare a skill plan \n    - use a bucket (hash) to determine treatment or control\n        - only execute treatment \n3. execute_workflow\n    - generete workflow \n        - based on action.steps\n",
      "lineHeight": 1.25
    }
  ],
