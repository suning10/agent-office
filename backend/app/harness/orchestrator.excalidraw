      "seed": 1124961455,
      "version": 484,
      "versionNonce": 1829209391,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791574173448,
      "link": null,
      "locked": false,
      "text": "1. use LLM to rewrite\n    - use canonical = synonyms \n        - from glossary (predefined)\n    - call pi/local/just append the matched syn to the query\n        - return a list of rewrote queries\n        - call dedup to remove duplicate\n            - dedup by check if the one exists before",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 168,
      "containerId": null,
      "originalText": "1. use LLM to rewrite\n    - use canonical = synonyms \n        - from glossary (predefined)\n    - call pi/local/just append the matched syn to the query\n        - return a list of rewrote queries\n        - call dedup to remove duplicate\n            - dedup by check if the one exists before",
      "lineHeight": 1.25
    },
