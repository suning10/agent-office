    {
      "id": "FJ-oANySj50dUa6f_5SwL",
      "type": "text",
      "x": 191,
      "y": 1731,
      "width": 708.079345703125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
