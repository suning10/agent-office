      "text": "get feedback: feedback collector\n\nreport: dict[str, Any] = {\n      \"cycle_id\": \"loop_cycle_\" + uuid.uuid4().hex[:12],\n      \"started_at\": started_at.isoformat(),\n      \"observed\": len(pending), \n      \"bad_cases\": len(bad_cases), \n      \"signals\": signal_counts,\n        }\n",
